# Normalize line endings in the repository; scripts keep what their shells need.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (test and sample content) are stored with Git LFS. Third-party archives are
# fetched at configure time instead of being committed.
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.hdr filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
# Golden images of the GPU tests (uncompressed binary PPM until the engine has a PNG decoder,
# ADR-0029 rule 18).
*.ppm filter=lfs diff=lfs merge=lfs -text

# Fuzz seed corpora are small binary files kept in Git directly (no LFS), never converted.
tests/**/fuzz_seeds/**/*.bin -text
tests/**/fuzz_seeds/**/*.spv -text
tests/**/fuzz_seeds/**/*.glb -filter -diff -merge -text
