// The engine's default keymap (ADR-0008 rule 4, ADR-0029 rule 16): editor command id to its
// chords. A chord is a stable control name (ADR-0013) after optional "Ctrl+", "Shift+" and
// "Alt+" modifiers; [] unbinds a command in a higher layer. The viewport navigation of rule 4
// (fly, orbit, dolly, pan, fly speed, Alt + drag to duplicate) is held input, not commands, and
// comes with the viewport. The command ids are confirmed by the command registry (P2 step 7).
{
  "format": "ith.config",
  "version": 1,
  "data": {
    "commands": {
      "ith.viewport.focus_selection": ["Keyboard.F"],
      "ith.viewport.translate_tool": ["Keyboard.W"],
      "ith.viewport.rotate_tool": ["Keyboard.E"],
      "ith.viewport.scale_tool": ["Keyboard.R"],
      "ith.viewport.cycle_tool": ["Keyboard.Space"],
      "ith.viewport.snap_to_floor": ["Keyboard.End"],
      "ith.viewport.game_view": ["Keyboard.G"],
      "ith.viewport.immersive": ["Keyboard.F11"],
      "ith.edit.duplicate": ["Ctrl+Keyboard.D"],
      "ith.content_browser.open_drawer": ["Ctrl+Keyboard.Space"],
      "ith.play.stop": ["Keyboard.Escape"],
      "ith.play.free_mouse": ["Shift+Keyboard.F1"],
      "ith.play.possess_or_eject": ["Keyboard.F8"]
    }
  }
}
