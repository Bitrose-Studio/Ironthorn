      {"command": "ith.query.history", "expect": {"cursor": 2, "canUndo": true}},
      {"command": "ith.play.keep_simulation_changes", "args": {"ids": ["00000000-0000-00ed-0000-000000000001"]}, "expect": {"kept": []}},
      {"command": "ith.selection.set", "args": {"entities": ["00000000-0000-00ed-0000-000000000001"]}},
      {"command": "ith.query.selection", "expect": {"primary": "00000000-0000-00ed-0000-000000000001"}},
      {"command": "ith.edit.select_none"},
      {"command": "ith.query.selection", "expect": {"entities": []}},
      {"command": "ith.query.selection", "args": {"world": "editor"}, "expect": {"entities": ["00000000-0000-00ed-0000-000000000001"]}},
      {"command": "ith.edit.select_all"},
      {"command": "ith.query.find", "args": {"label": "Crate"}, "expect": {"ids": ["00000000-0000-00ed-0000-000000000001"]}},
      {"command": "ith.query.world_hash", "args": {"world": "game"}, "expect": {"entities": 1}},
      {"command": "ith.edit.undo", "expectError": "editor.command.playing"},
      {"command": "ith.entity.create", "args": {"label": "Barrel"}, "expectError": "editor.command.playing"},
      {"command": "ith.entity.set_enabled", "args": {"ids": ["00000000-0000-00ed-0000-000000000001"], "enabled": false},
       "expectError": "editor.command.playing"},
      {"command": "ith.file.save", "expectError": "editor.command.playing"},
      {"command": "ith.file.save_as", "args": {"path": "Content/Play.ithmap"}, "expectError": "editor.command.playing"},
      {"command": "ith.file.new_level", "args": {"unsaved": "discard"}, "expectError": "editor.command.playing"},

      {"command": "ith.play.pause", "expect": {"paused": false}},
      {"command": "ith.play.step", "expectError": "editor.play.not_paused"},
      {"command": "ith.play.pause", "args": {"paused": true}, "expect": {"paused": true}},
      {"command": "ith.play.step", "expect": {"frame": 3}},
