{
  "format": "ith.automation_script",
  "version": 1,
  "data": {
    "steps": [
      {"command": "ith.content.toggle_drawer", "args": {"open": false}, "expect": {"open": false, "target": "drawer"}},
      {"command": "ith.file.new_level", "args": {"unsaved": "discard"}},
      {"command": "ith.file.save_as", "args": {"path": "Content/Browse/Levels/Main.ithmap"}},
      {"wait": "idle"},
      {"command": "ith.file.new_level"},
      {"command": "ith.file.save_as", "args": {"path": "Content/Browse/Levels/Second.ithmap"}},
      {"wait": "idle"},
      {"command": "ith.content.navigate", "args": {"folder": "Browse"}, "expect": {"folder": "Browse"}},
      {"command": "ith.query.content", "expect": {"folder": "Browse", "items": [{"kind": "folder", "label": "Levels", "path": "Browse/Levels", "problems": []}]}},
      {"command": "ith.query.content_tree", "expect": {"current": "Browse"}},
      {"command": "ith.content.navigate", "args": {"folder": "Browse/Nowhere"}, "expectError": "editor.content.not_found"},
      {"command": "ith.content.open", "args": {"item": {"path": "Browse/Levels"}}, "expect": {"folder": "Browse/Levels"}},
      {"command": "ith.query.content", "expect": {"items": [
        {"kind": "asset", "label": "Main", "path": "Browse/Levels/Main.ithmap", "type": "ith.level", "category": "level"},
        {"kind": "asset", "label": "Second", "path": "Browse/Levels/Second.ithmap", "type": "ith.level", "category": "level"}]}},
      {"command": "ith.content.select", "args": {"items": [{"path": "Browse/Levels/Main.ithmap"}], "mode": "replace"},
       "expect": {"selection": [{"path": "Browse/Levels/Main.ithmap"}], "primary": {"path": "Browse/Levels/Main.ithmap"}}},
      {"command": "ith.content.select", "args": {"items": [{"path": "Browse/Levels/Second.ithmap"}], "mode": "range"},
       "expect": {"selection": [{"path": "Browse/Levels/Main.ithmap"}, {"path": "Browse/Levels/Second.ithmap"}]}},
      {"command": "ith.query.content", "expect": {"anchor": {"path": "Browse/Levels/Main.ithmap"}, "focus": {"path": "Browse/Levels/Second.ithmap"}}},
      {"command": "ith.content.select", "args": {"items": [{"path": "Browse/Levels/Gone.ithmap"}]}, "expectError": "editor.content.not_found"},
      {"command": "ith.content.dismiss", "expect": {"selection": [], "primary": null}},
      {"command": "ith.content.select_all", "expect": {"selection": [{"path": "Browse/Levels/Main.ithmap"}, {"path": "Browse/Levels/Second.ithmap"}]}},
      {"command": "ith.content.set_view", "args": {"mode": "list", "sortBy": "name", "descending": true}, "expect": {"mode": "list", "sortBy": "name", "descending": true}},
      {"command": "ith.query.content", "expect": {"view": {"mode": "list"}, "items": [{"label": "Second"}, {"label": "Main"}]}},
      {"command": "ith.content.set_view", "args": {"mode": "grid", "descending": false}, "expect": {"mode": "grid", "descending": false}},
      {"command": "ith.content.navigate_up", "expect": {"folder": "Browse"}},
      {"command": "ith.content.set_filter", "args": {"search": "sec", "categories": ["level"]}, "expect": {"shown": 1}},
      {"command": "ith.query.content", "expect": {"search": "sec", "categories": ["level"], "items": [{"label": "Second", "path": "Browse/Levels/Second.ithmap"}]}},
      {"command": "ith.content.set_filter", "args": {"search": "", "categories": []}, "expect": {"shown": 1}},
      {"command": "ith.content.set_filter", "args": {"categories": ["sounds"]}, "expectError": "editor.command.invalid_args"},
      {"command": "ith.content.navigate", "args": {"folder": "Browse/Levels"}},
      {"command": "ith.content.open", "args": {"item": {"path": "Browse/Levels/Main.ithmap"}}},
      {"wait": "idle"},
      {"command": "ith.query.document", "expect": {"path": "Content/Browse/Levels/Main.ithmap", "dirty": false}},
      {"command": "ith.entity.create", "args": {"id": "00000000-0000-00ed-0000-0000000000c1"}},
      {"command": "ith.content.open", "args": {"item": {"path": "Browse/Levels/Second.ithmap"}}, "expectError": "editor.document.unsaved_changes"},
      {"command": "ith.content.open", "args": {"item": {"path": "Browse/Levels/Second.ithmap"}, "unsaved": "discard"}},
      {"wait": "idle"},
      {"command": "ith.query.document", "expect": {"path": "Content/Browse/Levels/Second.ithmap", "dirty": false}},
      {"command": "ith.query.history", "expect": {"entries": []}},
      {"command": "ith.content.toggle_drawer"},
      {"command": "ith.content.toggle_drawer", "args": {"open": false}, "expect": {"open": false}},
      {"command": "ith.content.rescan"},
      {"command": "ith.query.content_problems"},
      {"command": "ith.query.content", "expect": {"folder": "Browse/Levels", "drawerOpen": false, "prompt": null}}
    ]
  }
}
