        {"kind": "asset", "label": "Second", "path": "Browse/Levels/Second.ithmap", "type": "ith.level", "category": "level"}]}},
      {"command": "ith.content.select", "args": {"items": [{"path": "Browse/Levels/Main.ithmap"}], "mode": "replace"},
       "expect": {"selection": [{"path": "Browse/Levels/Main.ithmap"}], "primary": {"path": "Browse/Levels/Main.ithmap"}}},
      {"command": "ith.content.select", "args": {"items": [{"path": "Browse/Levels/Second.ithmap"}], "mode": "range"},
       "expect": {"selection": [{"path": "Browse/Levels/Main.ithmap"}, {"path": "Browse/Levels/Second.ithmap"}]}},
      {"command": "ith.query.content", "expect": {"anchor": {"path": "Browse/Levels/Main.ithmap"}, "focus": {"path": "Browse/Levels/Second.ithmap"}}},
      {"command": "ith.content.select", "args": {"items": [{"path": "Browse/Levels/Gone.ithmap"}]}, "expectError": "editor.content.not_found"},
      {"command": "ith.content.dismiss", "expect": {"selection": [], "primary": null}},
      {"command": "ith.content.select_all", "expect": {"selection": [{"path": "Browse/Levels/Main.ithmap"}, {"path": "Browse/Levels/Second.ithmap"}]}},
      {"command": "ith.content.set_view", "args": {"mode": "list", "sortBy": "name", "descending": true}, "expect": {"mode": "list", "sortBy": "name", "descending": true}},
      {"command": "ith.query.content", "expect": {"view": {"mode": "list"}, "items": [{"label": "Second"}, {"label": "Main"}]}},
      {"command": "ith.content.set_view", "args": {"mode": "grid", "descending": false}, "expect": {"mode": "grid", "descending": false}},
      {"command": "ith.content.navigate_up", "expect": {"folder": "Browse"}},
      {"command": "ith.content.set_filter", "args": {"search": "sec", "categories": ["level"]}, "expect": {"shown": 1}},
      {"command": "ith.query.content", "expect": {"search": "sec", "categories": ["level"], "items": [{"label": "Second", "path": "Browse/Levels/Second.ithmap"}]}},
      {"command": "ith.content.set_filter", "args": {"search": "", "categories": []}, "expect": {"shown": 1}},
      {"command": "ith.content.set_filter", "args": {"categories": ["sounds"]}, "expectError": "editor.command.invalid_args"},
      {"command": "ith.content.navigate", "args": {"folder": "Browse/Levels"}},
      {"command": "ith.content.open", "args": {"item": {"path": "Browse/Levels/Main.ithmap"}}},
      {"wait": "idle"},
      {"command": "ith.query.document", "expect": {"path": "Content/Browse/Levels/Main.ithmap", "dirty": false}},
      {"command": "ith.entity.create", "args": {"id": "00000000-0000-00ed-0000-0000000000c1"}},
      {"command": "ith.content.open", "args": {"item": {"path": "Browse/Levels/Second.ithmap"}}, "expectError": "editor.document.unsaved_changes"},
      {"command": "ith.content.open", "args": {"item": {"path": "Browse/Levels/Second.ithmap"}, "unsaved": "discard"}},
      {"wait": "idle"},
      {"command": "ith.query.document", "expect": {"path": "Content/Browse/Levels/Second.ithmap", "dirty": false}},
      {"command": "ith.query.history", "expect": {"entries": []}},
      {"command": "ith.content.toggle_drawer"},
      {"command": "ith.content.toggle_drawer", "args": {"open": false}, "expect": {"open": false}},
      {"command": "ith.content.rescan"},
      {"command": "ith.query.content_problems"},
      {"command": "ith.query.content", "expect": {"folder": "Browse/Levels", "drawerOpen": false, "prompt": null}},
      {"command": "ith.content.new_folder", "args": {"parent": "Browse"}, "expect": {"path": "Browse/New Folder", "prompt": "rename"}},
      {"command": "ith.query.content", "expect": {"prompt": {"kind": "rename", "name": "New Folder", "item": {"path": "Browse/New Folder"}}}},
      {"command": "ith.content.rename", "args": {"item": {"path": "Browse/New Folder"}, "name": "Props"}, "expect": {"path": "Browse/Props"}},
      {"command": "ith.content.new_folder", "args": {"parent": "Browse", "name": "props"}, "expectError": "editor.content.exists"},
      {"command": "ith.content.rename", "args": {"item": {"path": "Browse/Props"}, "name": "a:b"}, "expectError": "editor.content.invalid_name"},
      {"command": "ith.content.duplicate", "args": {"items": [{"path": "Browse/Levels/Main.ithmap"}]},
       "expect": {"created": [{"path": "Browse/Levels/Main_2.ithmap"}], "skipped": [], "failed": []}},
      {"command": "ith.content.move", "args": {"items": [{"path": "Browse/Levels/Main_2.ithmap"}], "folder": "Browse/Props"},
       "expect": {"moved": [{"path": "Browse/Props/Main_2.ithmap"}], "failed": []}},
      {"command": "ith.content.move", "args": {"items": [{"path": "Browse/Props"}], "folder": "Browse/Props"}, "expectError": "editor.content.invalid_target"},
      {"command": "ith.content.rename", "args": {"item": {"path": "Browse/Levels/Second.ithmap"}, "name": "Opened"}, "expect": {"path": "Browse/Levels/Opened.ithmap"}},
      {"command": "ith.query.document", "expect": {"path": "Content/Browse/Levels/Opened.ithmap", "dirty": false}},
      {"command": "ith.content.delete", "args": {"items": [{"path": "Browse/Levels/Opened.ithmap"}], "confirmed": true}, "expectError": "editor.content.level_open"},
      {"command": "ith.content.delete", "args": {"items": [{"path": "Browse/Props"}]},
       "expect": {"deleted": false, "preview": {"count": 1, "assets": 1, "otherFiles": 0, "uses": []}}},
      {"command": "ith.query.content", "expect": {"prompt": {"kind": "delete", "deleted": false}}},
      {"command": "ith.content.delete", "args": {"items": [{"path": "Browse/Props"}], "confirmed": true}, "expect": {"deleted": [{"path": "Browse/Props"}], "failed": []}},
      {"command": "ith.content.delete", "args": {"items": [{"path": ""}], "confirmed": true}, "expectError": "editor.content.root"},
      {"command": "ith.file.new_level"},
      {"command": "ith.file.save_as", "args": {"path": "Outside/Extra.ithmap"}},
      {"wait": "idle"},
      {"command": "ith.file.save_as", "args": {"path": "Outside/notes.txt"}},
      {"wait": "idle"},
      {"command": "ith.content.import", "args": {"files": ["Outside/Extra.ithmap", "Outside/notes.txt"], "folder": "Browse"},
       "expect": {"imported": [{"path": "Browse/Extra.ithmap", "newId": false}], "skipped": [{"reason": "no importer for .txt"}], "failed": []}},
      {"command": "ith.query.content", "expect": {"folder": "Browse", "selection": [{"path": "Browse/Extra.ithmap"}]}},
      {"command": "ith.content.import", "args": {"files": ["Outside/Extra.ithmap"], "folder": "Browse"},
       "expect": {"done": false, "conflicts": [{"target": "Browse/Extra.ithmap", "replace": false}]}},
      {"command": "ith.query.content", "expect": {"prompt": {"kind": "import_conflicts", "folder": "Browse"}}},
      {"command": "ith.content.import", "args": {"files": ["Outside/Extra.ithmap"], "folder": "Browse", "conflict": "keep_both"},
       "expect": {"imported": [{"path": "Browse/Extra_2.ithmap", "newId": true}]}},
      {"command": "ith.content.reimport", "args": {"items": [{"path": "Browse/Extra.ithmap"}]}, "expectError": "editor.content.not_imported"},
      {"command": "ith.content.fix", "args": {"item": {"path": "Browse/Extra.ithmap"}}, "expectError": "editor.content.invalid_target"},
      {"command": "ith.query.history", "expect": {"entries": []}},
      {"command": "ith.query.content", "expect": {"prompt": null}}
    ]
  }
}
