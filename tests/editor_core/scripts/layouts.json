{
  "format": "ith.automation_script",
  "version": 1,
  "data": {
    "steps": [
      {"command": "ith.window.reset_layout", "expect": {"name": "Default", "warnings": []}},
      {"command": "ith.query.layout", "expect": {"name": "Default", "open": ["ith.viewport.1", "ith.output_log", "ith.outliner", "ith.details"]}},
      {"command": "ith.window.close_panel", "args": {"panel": "ith.output_log"}, "expect": {"panel": "ith.output_log", "closed": true}},
      {"command": "ith.window.close_panel", "args": {"panel": "ith.output_log"}, "expect": {"closed": false}},
      {"command": "ith.query.layout", "expect": {"open": ["ith.viewport.1", "ith.outliner", "ith.details"]}},
      {"command": "ith.window.open_panel", "args": {"panel": "ith.output_log"}, "expect": {"panel": "ith.output_log", "opened": true}},
      {"command": "ith.window.open_panel", "args": {"panel": "ith.output_log"}, "expect": {"opened": false}},
      {"command": "ith.window.open_panel", "args": {"panel": "ith.no_such_panel"}, "expectError": "editor.layout.unknown_panel"},
      {"command": "ith.window.save_layout_as", "args": {"name": "Test"}, "expect": {"name": "Test"}},
      {"command": "ith.window.save_layout_as", "args": {"name": "test"}, "expectError": "editor.layout.exists"},
      {"command": "ith.window.save_layout_as", "args": {"name": "test", "overwrite": true}, "expect": {"name": "Test"}},
      {"command": "ith.window.save_layout_as", "args": {"name": "Default"}, "expectError": "editor.layout.reserved_name"},
      {"command": "ith.window.save_layout_as", "args": {"name": "bad/name"}, "expectError": "editor.layout.invalid_name"},
      {"command": "ith.window.set_default_layout", "args": {"name": "Test"}, "expect": {"name": "Test"}},
      {"command": "ith.query.layouts", "expect": {"layouts": [{"name": "Default", "layer": "engine"}, {"name": "Test", "layer": "user"}], "default": "Test"}},
      {"command": "ith.window.close_panel", "args": {"panel": "ith.output_log"}},
      {"command": "ith.window.load_layout", "args": {"name": "default"}, "expect": {"name": "Default"}},
      {"command": "ith.query.layout", "expect": {"name": "Default", "open": ["ith.viewport.1", "ith.output_log", "ith.outliner", "ith.details"]}},
      {"command": "ith.window.close_panel", "args": {"panel": "ith.output_log"}},
      {"command": "ith.window.reset_layout", "expect": {"name": "Test"}},
      {"command": "ith.query.layout", "expect": {"open": ["ith.viewport.1", "ith.outliner", "ith.details", "ith.output_log"]}},
      {"command": "ith.window.delete_layout", "args": {"name": "Default"}, "expectError": "editor.layout.reserved_name"},
      {"command": "ith.window.delete_layout", "args": {"name": "Test"}, "expect": {"name": "Test"}},
      {"command": "ith.query.layouts", "expect": {"layouts": [{"name": "Default", "layer": "engine"}], "default": "Default"}},
      {"command": "ith.window.load_layout", "args": {"name": "Test"}, "expectError": "editor.layout.not_found"},
      {"command": "ith.window.reset_layout", "expect": {"name": "Default"}}
    ]
  }
